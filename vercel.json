{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/react",
      "dest": "/react.html"
    },
    {
      "src": "/mobile_logo",
      "dest": "/mobile_logo.html"
    }
  ],
  "ignore": [
    "app.py",
    "api.py",
    "*.py"
  ]
}